# Base d'inscrits — source de verite de la liste (QG 6.4).
# Neon ou Supabase. Appliquer db/schema.sql avant le premier deploiement.
DATABASE_URL=

# Envoi des emails. Resend ne stocke rien : il ne fait qu'envoyer.
RESEND_API_KEY=
RESEND_FROM="Chaud Devant <bonjour@chauddevant.fr>"

# CMS recettes. Sans ces deux variables, /recettes affiche son etat vide.
NOTION_TOKEN=
NOTION_RECIPES_DATA_SOURCE_ID=b4d32cda-0bee-492c-bae4-76267dcf0492

# URL publique, utilisee dans les liens des emails, le sitemap et les metadonnees.
NEXT_PUBLIC_SITE_URL=
