# Base d'inscrits — source de verite de la liste (QG 6.4).
# Neon ou Supabase. Rien a appliquer a la main : l’application pose son schema
# elle-meme au premier acces (db/schema.ts).
DATABASE_URL=

# Envoi des emails. Resend ne stocke rien : il ne fait qu'envoyer.
RESEND_API_KEY=
RESEND_FROM="Chaud Devant <bonjour@chauddevant.fr>"

# Acces a l'atelier (/login). Sans lui, l'espace prive reste ferme.
# Un secret partage : le changer deconnecte tout le monde, ce qui est voulu.
ADMIN_PASSWORD=

# URL publique, utilisee dans les liens des emails, le sitemap et les metadonnees.
NEXT_PUBLIC_SITE_URL=
